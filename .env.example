# ElevenLabs の API キー。https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# A: Agents Platform で使う Agent の id（`agent_...`）。まだ作っていなければ空でよい
ELEVENLABS_AGENT_ID=

# 声。既定は無料プランでも使える premade の "Sarah"
# 日本語ネイティブの声（"Aya" = MXKtCrra8fvlDUbfKUT1）は Starter 以上
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# TTS モデル。会話用は flash（速い方）を使う
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Agent の応答生成に使う LLM。既定は gemini-3.6-flash（速くて安い）
VOICELAB_LLM=gemini-3.6-flash

# B（自前構成）が使う Gemini の API キー。https://aistudio.google.com/apikey
# A は ElevenLabs 側が同じモデル（VOICELAB_LLM）を動かすので鍵は要らない
GEMINI_API_KEY=
